# Project xschemrc: the SKY130 PDK's settings, plus this folder for the inverter's symbol.
# xschem reads ./xschemrc when it starts in this folder (CACE netlists the circuit from here).

if { ![info exists env(PDK_ROOT)] } {
  set ::env(PDK_ROOT) /foss/pdks
}
if { ![info exists env(PDK)] } {
  set ::env(PDK) sky130A
}

# The PDK's xschemrc: device symbols (sky130_fd_pr/...), SKYWATER_MODELS, devices/ library.
if { ![info exists PDK] } {
  source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
}

# This folder (inverter.sym, inverter.sch).
append XSCHEM_LIBRARY_PATH :[file dirname [file normalize [info script]]]
